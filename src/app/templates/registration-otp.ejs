
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Verify Your Account | PH-Health-Care</title>
</head>

<body style="margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background:#f1f5f9;padding:35px 15px;">

    <tr>
      <td align="center">

        <!-- Email Wrapper -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e2e8f0;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="padding:35px 25px;background:#2563eb;background-image:linear-gradient(135deg,#2563eb,#4f46e5);">

              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center"
                    style="width:58px;height:58px;background:#ffffff;border-radius:16px;">

                    <span style="font-size:34px;font-weight:bold;color:#2563eb;">+</span>

                  </td>
                </tr>
              </table>

              <h1 style="margin:15px 0 7px;color:#ffffff;font-size:27px;">
                PH-Health-Care
              </h1>

              <p style="margin:0;color:#dbeafe;font-size:14px;">
                Your Health, Our Priority.
              </p>

            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:35px 30px 25px;">

              <p style="margin:0 0 12px;color:#2563eb;font-size:12px;font-weight:bold;letter-spacing:1.3px;">
                ACCOUNT VERIFICATION
              </p>

              <h2 style="margin:0 0 18px;color:#111827;font-size:25px;">
                Welcome to PH-Health-Care! 🎉
              </h2>

          
<p style="margin:0 0 8px;color:#374151;font-size:15px;line-height:25px;">
  Hello <strong><%= name %></strong>,
</p>

<p style="margin:0 0 22px;color:#64748b;font-size:13px;line-height:22px;">
  Registered Email:
  <strong style="color:#2563eb;"><%= email %></strong>
</p>

              <p style="margin:0 0 25px;color:#64748b;font-size:14px;line-height:25px;">
                Thank you for registering with PH-Health-Care!
                We're excited to have you on board. To complete your
                registration and activate your account, please verify
                your email address using the verification code below.
              </p>

              <!-- OTP Box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background:#eff6ff;border:1px dashed #93c5fd;border-radius:14px;">

                <tr>
                  <td align="center" style="padding:25px 15px 10px;">

                    <p style="margin:0 0 15px;color:#64748b;font-size:12px;font-weight:bold;letter-spacing:1px;">
                      YOUR VERIFICATION CODE
                    </p>

                    <h1 style="margin:0;color:#2563eb;font-size:38px;letter-spacing:12px;padding-left:12px;">
                      <%= otp %>
                    </h1>

                  </td>
                </tr>

                <tr>
                  <td align="center" style="padding:12px 15px 22px;">

                    <span style="display:inline-block;padding:8px 16px;background:#dbeafe;border-radius:20px;color:#1d4ed8;font-size:12px;font-weight:bold;">
                      ⏱ Expires in 5 minutes
                    </span>

                  </td>
                </tr>

              </table>

              <!-- Verification Notice -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-top:25px;background:#ecfdf5;border-left:4px solid #10b981;border-radius:7px;">

                <tr>
                  <td style="padding:16px;">

                    <p style="margin:0 0 7px;color:#065f46;font-size:14px;font-weight:bold;">
                      ✓ Almost There!
                    </p>

                    <p style="margin:0;color:#047857;font-size:13px;line-height:22px;">
                      Enter this verification code in PH-Health-Care
                      to verify your email address and complete your registration.
                    </p>

                  </td>
                </tr>

              </table>

              <!-- Security Notice -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-top:15px;background:#fffbeb;border-left:4px solid #f59e0b;border-radius:7px;">

                <tr>
                  <td style="padding:16px;">

                    <p style="margin:0 0 7px;color:#92400e;font-size:14px;font-weight:bold;">
                      ⚠ Important Security Notice
                    </p>

                    <p style="margin:0;color:#a16207;font-size:13px;line-height:22px;">
                      Never share this verification code with anyone.
                      Our team will never ask you for your OTP.
                    </p>

                  </td>
                </tr>

              </table>

              <p style="margin:25px 0 0;color:#64748b;font-size:13px;line-height:23px;">
                Didn't create an account with PH-Health-Care?
                You can safely ignore this email. No account will be
                activated without email verification.
              </p>

              <p style="margin:25px 0 0;color:#374151;font-size:14px;line-height:24px;">
                Best regards,<br />
                <strong style="color:#2563eb;">PH-Health-Care Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:25px 25px;background:#f8fafc;border-top:1px solid #e5e7eb;">

              <h3 style="margin:0 0 10px;color:#1e293b;font-size:15px;">
                Need Help?
              </h3>

              <p style="margin:0 0 8px;color:#64748b;font-size:12px;line-height:21px;">
                If you have any questions or need assistance,
                feel free to contact our support team.
              </p>

              <p style="margin:12px 0 18px;">
                <a href="mailto:support@yourdomain.com"
                  style="color:#2563eb;font-size:13px;font-weight:bold;text-decoration:none;">
                  support@yourdomain.com
                </a>
              </p>

              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-top:1px solid #e2e8f0;padding-top:18px;">

                    <p style="margin:0 0 8px;color:#64748b;font-size:11px;">
                      © <%= year %> PH-Health-Care. All rights reserved.
                    </p>

                    <p style="margin:0 0 10px;color:#94a3b8;font-size:11px;line-height:19px;">
                      This is an automated email. Please do not reply to this message.
                    </p>

                    <p style="margin:0;color:#2563eb;font-size:12px;font-weight:bold;">
                      Your Health, Our Priority ❤️
                    </p>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

        </table>

        <p style="margin:18px 0 0;color:#94a3b8;font-size:11px;">
          Secure communication from PH-Health-Care.
        </p>

      </td>
    </tr>
  </table>

</body>
</html>
