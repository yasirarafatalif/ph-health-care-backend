<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PH-Health-Care Password Reset</title>
</head>

<body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 15px;background:#f4f7fb;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0"
          style="max-width:500px;background:#ffffff;border-radius:16px;overflow:hidden;">

          <tr>
            <td align="center" style="background:#2563eb;padding:30px;">
              <h1 style="margin:0;color:#ffffff;font-size:28px;">PH-Health-Care</h1>
              <p style="color:#dbeafe;font-size:14px;">
                Reliable service, right at your doorstep.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:35px 30px;">

              <h2 style="color:#111827;">Password Reset Request</h2>

              <p style="color:#4b5563;line-height:1.7;">
                Hello <%= name %>,
              </p>

              <p style="color:#4b5563;line-height:1.7;">
                We received a request to reset your ph-health-care account password.
                Use the verification code below to continue.
              </p>

              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center"
                    style="background:#eff6ff;border:1px dashed #93c5fd;border-radius:12px;padding:25px;">
                    <p style="color:#64748b;font-size:13px;">Your verification code</p>

                    <h1 style="margin:0;color:#2563eb;font-size:36px;letter-spacing:10px;">
                      <%= otp %>
                    </h1>
                  </td>
                </tr>
              </table>

              <p style="color:#4b5563;line-height:1.7;margin-top:25px;">
                This code expires in <strong>5 minutes</strong>.
                Please do not share it with anyone.
              </p>

              <p style="color:#4b5563;line-height:1.7;">
                If you did not request a password reset, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <tr>
            <td style="padding:20px 30px;text-align:center;border-top:1px solid #e5e7eb;">
              <p style="color:#9ca3af;font-size:12px;">
                © <%= year %> PH-Health-Care. All rights reserved.
              </p>
              <p style="color:#9ca3af;font-size:12px;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>