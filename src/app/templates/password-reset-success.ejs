<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PH-Health-Care Password Reset Successful</title>
</head>

<body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 15px;background:#f4f7fb;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0"
          style="max-width:500px;background:#ffffff;border-radius:16px;overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background:#16a34a;padding:30px;">
              <h1 style="margin:0;color:#ffffff;font-size:28px;">
                PH-Health-Care
              </h1>
              <p style="color:#dcfce7;font-size:14px;">
                Your health, our priority.
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:35px 30px;">

              <!-- Success Icon -->
              <div style="text-align:center;margin-bottom:20px;">
                <div style="display:inline-block;width:65px;height:65px;line-height:65px;
                  background:#dcfce7;border-radius:50%;color:#16a34a;font-size:35px;">
                  &#10003;
                </div>
              </div>

              <h2 style="color:#111827;text-align:center;margin-bottom:20px;">
                Password Reset Successful!
              </h2>

              <p style="color:#4b5563;line-height:1.7;">
                Hello <%= name %>,
              </p>

              <p style="color:#4b5563;line-height:1.7;">
                Your PH-Health-Care account password has been successfully changed.
                You can now log in using your new password.
              </p>

              <!-- Success Information -->
              <table width="100%" cellpadding="0" cellspacing="0"
                style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;">
                <tr>
                  <td style="padding:20px;">
                    <p style="margin:0 0 10px;color:#166534;font-size:15px;font-weight:bold;">
                      ✓ Password Updated
                    </p>

                    <p style="margin:0;color:#4b5563;font-size:14px;line-height:1.7;">
                      Your account security credentials have been updated successfully.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="color:#4b5563;line-height:1.7;margin-top:25px;">
                <strong>Didn't make this change?</strong>
                If you did not reset your password, please contact our support team
                immediately to protect your account.
              </p>

              <p style="color:#4b5563;line-height:1.7;">
                For your security, never share your password with anyone.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:20px 30px;text-align:center;border-top:1px solid #e5e7eb;">

              <p style="color:#9ca3af;font-size:12px;">
                © <%= year %> PH-Health-Care. All rights reserved.
              </p>

              <p style="color:#9ca3af;font-size:12px;">
                This is an automated email. Please do not reply.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>