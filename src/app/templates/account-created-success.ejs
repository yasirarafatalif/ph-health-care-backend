
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Account Created Successfully | PH-Health-Care</title>
</head>

<body style="margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background:#f1f5f9;padding:35px 15px;">

    <tr>
      <td align="center">

        <!-- Email Wrapper -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e2e8f0;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="padding:35px 25px;background:#2563eb;background-image:linear-gradient(135deg,#2563eb,#4f46e5);">

              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center"
                    style="width:58px;height:58px;background:#ffffff;border-radius:16px;">

                    <span style="font-size:34px;font-weight:bold;color:#2563eb;">+</span>

                  </td>
                </tr>
              </table>

              <h1 style="margin:15px 0 7px;color:#ffffff;font-size:27px;">
                PH-Health-Care
              </h1>

              <p style="margin:0;color:#dbeafe;font-size:14px;">
                Your Health, Our Priority.
              </p>

            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:35px 30px 30px;">

              <p style="margin:0 0 12px;color:#10b981;font-size:12px;font-weight:bold;letter-spacing:1.3px;">
                ACCOUNT CONFIRMATION
              </p>

              <h2 style="margin:0 0 18px;color:#111827;font-size:25px;">
                Account Created Successfully! 🎉
              </h2>

              <p style="margin:0 0 12px;color:#374151;font-size:15px;line-height:25px;">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="margin:0 0 8px;color:#64748b;font-size:13px;line-height:22px;">
                Registered Email:
                <strong style="color:#2563eb;"><%= email %></strong>
              </p>

              <p style="margin:22px 0;color:#64748b;font-size:14px;line-height:25px;">
                Congratulations! Your PH-Health-Care account has been
                successfully created and your email address has been verified.
                We're delighted to welcome you to our healthcare community.
              </p>

              <!-- Success Box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:14px;">

                <tr>
                  <td align="center" style="padding:25px 15px;">

                    <div style="font-size:42px;color:#10b981;">
                      ✓
                    </div>

                    <h2 style="margin:10px 0;color:#065f46;font-size:20px;">
                      You're All Set!
                    </h2>

                    <p style="margin:0;color:#047857;font-size:13px;line-height:22px;">
                      Your account is now active and ready to use.
                    </p>

                  </td>
                </tr>

              </table>

              <p style="margin:25px 0 15px;color:#374151;font-size:14px;line-height:24px;">
                You can now log in to your account and explore our
                healthcare services. We're here to help you take
                better care of your health.
              </p>

              <!-- Login Button -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding:15px 0 20px;">

                    <a href="<%= loginUrl %>"
                      style="display:inline-block;padding:14px 35px;background:#2563eb;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;border-radius:8px;">
                      Login to Your Account →
                    </a>

                  </td>
                </tr>
              </table>

              <p style="margin:10px 0 0;color:#374151;font-size:14px;line-height:24px;">
                Thank you for choosing us!
                <br />
                <strong style="color:#2563eb;">PH-Health-Care Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center"
              style="padding:25px;background:#f8fafc;border-top:1px solid #e5e7eb;">

              <h3 style="margin:0 0 10px;color:#1e293b;font-size:15px;">
                Need Help?
              </h3>

              <p style="margin:0 0 8px;color:#64748b;font-size:12px;line-height:21px;">
                If you have any questions or need assistance,
                feel free to contact our support team.
              </p>

              <p style="margin:12px 0 18px;">
                <a href="mailto:support@yourdomain.com"
                  style="color:#2563eb;font-size:13px;font-weight:bold;text-decoration:none;">
                  support@yourdomain.com
                </a>
              </p>

              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="border-top:1px solid #e2e8f0;padding-top:18px;">

                    <p style="margin:0 0 8px;color:#64748b;font-size:11px;">
                      © <%= year %> PH-Health-Care. All rights reserved.
                    </p>

                    <p style="margin:0 0 10px;color:#94a3b8;font-size:11px;line-height:19px;">
                      This is an automated email. Please do not reply to this message.
                    </p>

                    <p style="margin:0;color:#2563eb;font-size:12px;font-weight:bold;">
                      Your Health, Our Priority ❤️
                    </p>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

        </table>

        <p style="margin:18px 0 0;color:#94a3b8;font-size:11px;">
          Secure communication from PH-Health-Care.
        </p>

      </td>
    </tr>
  </table>

</body>
</html>